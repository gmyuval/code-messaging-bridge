# Database
CMB_DATABASE_URL=postgresql+asyncpg://cmb:cmb@localhost:5432/cmb
CMB_DATABASE_URL_SYNC=postgresql+psycopg2://cmb:cmb@localhost:5432/cmb

# Redis
CMB_REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Business API
CMB_META_PHONE_NUMBER_ID=your_phone_number_id
CMB_META_ACCESS_TOKEN=your_access_token
CMB_META_VERIFY_TOKEN=your_verify_token
CMB_META_APP_SECRET=your_app_secret

# Claude Code
CMB_CLAUDE_CLI_PATH=claude
CMB_CLAUDE_WORKING_DIRECTORY=.
CMB_CLAUDE_MAX_TURNS=10

# Server
CMB_HOST=0.0.0.0
CMB_PORT=8000
CMB_DEBUG=false
CMB_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# Security
CMB_ALLOWED_PHONE_NUMBERS=[]
